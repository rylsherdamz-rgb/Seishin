{
  "expo": {
    "name": "Seishin",
    "slug": "seishin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "seishin",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seishin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.seishin.app",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      "expo-mlkit-ocr",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Seishin to access your photos so you can attach them and scan schedules.",
          "cameraPermission": "Allow Seishin to use your camera to scan schedules and attach photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "llama.rn",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Seishin to sync your schedule with the calendars on this phone (Google, Outlook, Samsung)."
        }
      ],
      "expo-background-task",
      "expo-secure-store"
    ]
  }
}
