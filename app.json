{
  "expo": {
    "name": "Seishin",
    "slug": "seishin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "seishin",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seishin.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.seishin.app",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-dev-client",
      "expo-mlkit-ocr",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Seishin to access your photos so you can attach them and scan schedules.",
          "cameraPermission": "Allow Seishin to use your camera to scan schedules and attach photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "llama.rn",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Seishin to sync your schedule with the calendars on this phone (Google, Outlook, Samsung)."
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Agenda",
              "label": "Today",
              "description": "Today's and tomorrow's events and deadlines",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Tasks",
              "label": "Tasks",
              "description": "Open tasks \u2014 tap the circle to mark done",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Month",
              "label": "Month",
              "description": "Month calendar with event dots",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NextUp",
              "label": "Next up",
              "description": "Your next event or deadline with a countdown",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Quick",
              "label": "Quick add",
              "description": "One tap: new event, task, scan or note",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal"
            }
          ]
        }
      ]
    ]
  }
}
